# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
build/
out/
.vite/

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production

# Keep the example file
!.env.example

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Misc tooling ────────────────────────────────────────────────────────────
.eslintcache
.stylelintcache
*.tsbuildinfo
.cache/
.parcel-cache/
.turbo/

# ─── Uploads / user content ──────────────────────────────────────────────────
backend/uploads/

# ─── Package manager lock files (keep one) ───────────────────────────────────
# Commit package-lock.json; ignore yarn/pnpm locks if not used
yarn.lock
pnpm-lock.yaml

# ─── Terraform ────────────────────────────────────────────────────────────────
# State files — contain real infrastructure details + secrets
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfstate
terraform/*.tfstate.*

# tfvars — contains real values (AWS keys, secrets, CIDRs, etc.)
terraform/terraform.tfvars
terraform/*.tfvars
terraform/*.tfvars.json

# Terraform working directory — downloaded providers, modules cache
terraform/.terraform/
terraform/.terraform.lock.hcl

# Crash and debug logs generated by Terraform
terraform/crash.log
terraform/crash.*.log

# Override files — local-only overrides, never commit
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json

# CLI config (contains credentials)
terraform/.terraformrc
terraform/terraform.rc

# ─── AWS IAM policy downloads ─────────────────────────────────────────────────
iam_policy.json
