# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/bloomlater
MONGO_INITDB_ROOT_USERNAME=bloomlater
MONGO_INITDB_ROOT_PASSWORD=changeme_super_secret

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_64_byte_hex_access_secret
JWT_REFRESH_SECRET=replace_with_64_byte_hex_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — frontend origin (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# Storage — local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads

# S3 (only required when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api

# ─── Seed Script ─────────────────────────────────────────────────────────────
SEED_DEMO_PASSWORD=Demo1234!
